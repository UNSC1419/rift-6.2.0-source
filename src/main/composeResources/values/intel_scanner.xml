    <string name="intel_scanner_column_danger_name">Danger</string>
    <string name="intel_scanner_column_danger_description">An all-time kill and loss efficiency score calculated from ships destroyed and lost plus their zKillboard point values. Points account for ship size and PvP fitting, the number of attackers, and the relative sizes of the attacking and victim ships. A higher rating means the character is considered more dangerous.</string>
    <string name="intel_scanner_column_gang_name">Gang</string>
    <string name="intel_scanner_column_gang_description">The percentage of activity in gangs and the character's average gang size over their entire recorded history.</string>
    <string name="intel_scanner_column_solo_kills_name">Solo</string>
    <string name="intel_scanner_column_solo_kills_description">The number of solo kills attributed to the character over their entire recorded history.</string>
    <string name="intel_scanner_column_kill_death_ratio_name">K/D</string>
    <string name="intel_scanner_column_kill_death_ratio_description">The ratio and totals of ships destroyed to ships lost over the character's entire recorded history.</string>
    <string name="intel_scanner_column_group_size_name">Group size</string>
    <string name="intel_scanner_column_group_size_description">A chart of kills and losses grouped by the number of involved pilots over the character's entire recorded history.</string>
    <string name="intel_scanner_column_cyno_name">Cyno</string>
    <string name="intel_scanner_column_cyno_description">The number of losses with a cynosural field generator fitted in the past year, with a breakdown by generator type.</string>
    <string name="intel_scanner_column_space_name">Space</string>
    <string name="intel_scanner_column_space_description">A chart of kills and losses across highsec, lowsec, nullsec, wormhole, and abyssal space over the character's entire recorded history.</string>
    <string name="intel_scanner_column_isk_name">ISK</string>
    <string name="intel_scanner_column_isk_description">A chart of kills and losses grouped by the ISK value of the ships involved over the character's entire recorded history.</string>
    <string name="intel_scanner_column_tags_name">Tags</string>
    <string name="intel_scanner_column_tags_description">Playstyle tags inferred from the character's combat activity according to zKillboard.</string>
    <string name="intel_scanner_column_fleet_commander_name">FC</string>
    <string name="intel_scanner_column_fleet_commander_description">How likely the character is to be a fleet commander based on data in the past year. It counts appearances in a Monitor, Command Ships, and participation in large fleets. The score adds 20 points per Monitor appearance (maximum 100), 2 per Command Ship appearance (maximum 40), and 1 per five large-fleet appearances (maximum 20). The combined score produces Low (35+), Medium (60+), or High (100+), so large-fleet participation cannot earn the label by itself.</string>
    <string name="intel_scanner_column_top_ships_name">Top ships</string>
    <string name="intel_scanner_column_top_ships_description">The ships the character most often flew and lost in the past year.</string>
    <string name="intel_scanner_column_recent_ships_name">Recent ships</string>
    <string name="intel_scanner_column_recent_ships_description">The ships the character most often flew and lost in the past 90 days.</string>
    <string name="intel_scanner_column_affiliates_name">Affiliates</string>
    <string name="intel_scanner_column_affiliates_description">The alliances the character most often shared kills with according to zKillboard.</string>
    <string name="intel_scanner_column_associates_name">Associates</string>
    <string name="intel_scanner_column_associates_description">The size of the connected group of scanned characters who share kills according to zKillboard. When there are multiple groups, an identifier letter will also be shown. These characters are likely working together.</string>
    <string name="intel_scanner_column_awox_name">Awox</string>
    <string name="intel_scanner_column_awox_description">The number of kills against members of the character's own group in the past year. Low: 5+, Medium: 10+, High: 25+ matches.</string>
    <string name="intel_scanner_column_bait_name">Bait</string>
    <string name="intel_scanner_column_bait_description">Based on PvP ship losses under 10M ISK value followed within 5 minutes by a killmail with 2+ attackers no more than 250km from the loss that does not include the lost pilot in the past year. Low: 5+, Medium: 10+, High: 25+ matches.</string>
    <string name="intel_scanner_column_ganker_name">Gank</string>
    <string name="intel_scanner_column_ganker_description">How often the character was detected as a ganker. Low: 5+, Medium: 10+, High: 25+ matches in the past year.</string>
